[Unit]
Description=SICODE-UCT - Backup PostgreSQL programado
After=network.target postgresql.service

[Service]
Type=oneshot
User=__SICODE_USER__
WorkingDirectory=__SICODE_APPDIR__
EnvironmentFile=__SICODE_APPDIR__/.env
Environment=PYTHONPATH=__SICODE_APPDIR__
ExecStart=__SICODE_PYTHON__ __SICODE_APPDIR__/scripts/backup_programado.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
