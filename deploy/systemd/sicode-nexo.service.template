[Unit]
Description=SICODE NEXO - Revisión agregada y aprendizaje
After=postgresql.service network.target
Wants=postgresql.service

[Service]
Type=oneshot
User=__SICODE_USER__
WorkingDirectory=__SICODE_APPDIR__
EnvironmentFile=__SICODE_APPDIR__/.env
Environment=PYTHONPATH=__SICODE_APPDIR__
ExecStart=__SICODE_PYTHON__ -m flask --app run.py nexo-revisar
TimeoutStartSec=30min
PrivateTmp=true
NoNewPrivileges=true
Nice=10
